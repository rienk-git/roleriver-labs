{
  "name": "roleriver-labs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run --passWithNoTests --exclude \"**/*.live.test.ts\" --exclude \"**/*.integration.test.ts\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "eval:live": "vitest run packages/ai/evals/assessment.live.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "cli": "node dist/apps/cli/main.js",
    "test:integration": "vitest run packages/persistence/*.integration.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1178.0",
    "@aws-sdk/lib-dynamodb": "3.1178.0",
    "electrodb": "3.9.3",
    "zod": "4.6.7"
  }
}
